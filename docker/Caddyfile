# Caddy gets and renews the https certificate by itself (Let's Encrypt).
# The names are filled in by scripts/start.sh (or the address helper); you do
# not edit this file.
#
# EBP_SITE_NAMES is the main address, plus the free sslip.io backup address
# while you move to your own domain (docs/OWN_DOMAIN.md), for example
# "pay.myshop.com, 203-0-113-7.sslip.io". Each name gets its own certificate,
# so a problem with one never takes the other down.
{$EBP_SITE_NAMES} {
	encode gzip
	# Tell browsers to use https only for this address (about six months), so
	# nobody can be tricked into the plain http version of the admin page.
	# Not sent for the local test name, where it would only get in the way.
	@public not host localhost
	header @public Strict-Transport-Security "max-age=15552000"
	reverse_proxy ebp:8080
}
